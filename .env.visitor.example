# ── Visitor Management System ───────────────────────────────────────────────
# Titan Email SMTP (reused by the visitor mailer — same SMTP_* vars the project already uses)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<a Titan mailbox that is allowed to send as both aliases below>
SMTP_PASS=<mailbox password>        # secret — Vercel env only, never commit

# Optional overrides (defaults shown)
# VISITOR_APPROVAL_FROM="Abhishek Singh · Visitor Access" <visitors_approval@theabhisheksingh.in>
# VISITOR_NOTIFICATIONS_FROM="Abhishek Singh · Visitor Notifications" <visitors_notifications@theabhisheksingh.in>
# VISITOR_SITE_URL=https://www.theabhisheksingh.in    # origin used in activation/reset links

# Cron auth (Vercel sends it as "Authorization: Bearer <CRON_SECRET>"). REQUIRED: the visitor cron route is locked without it.
CRON_SECRET=<long random string>

# Rate limits are global only with Upstash; otherwise they are per-server-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo chat AI
ANTHROPIC_API_KEY=
